# 复制到服务器 /opt/quant-monitor/.env 后修改
# cp deploy/.env.production.example /opt/quant-monitor/.env

# 必填：对外访问务必设置强随机密钥（控制台 ① 里用户填同一串）
API_KEY=请改成至少32位随机字符

# 数据目录（SQLite 与快照 JSON 落盘位置）
DATA_DIR=/opt/quant-monitor/data

# 可选：TuShare 路线
# TUSHARE_TOKEN=

# ⑦ AI 潜力测算（OpenAI 兼容接口）
# AI_API_KEY=sk-...
# AI_API_BASE=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_SEC=90
# AI_JSON_MODE=true

# 东财限流间隔（秒），自选多时可适当加大
# EASTMONEY_REQUEST_MIN_INTERVAL_SEC=3
# EASTMONEY_REQUEST_MAX_INTERVAL_SEC=5

# 若服务器在国内且无需代理访问东财，可尝试直连
# INGEST_EASTMONEY_BYPASS_PROXY=false
